# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Set to "true" to enable resume upload in production (requires cloud file storage)
# NEXT_PUBLIC_RESUME_ANALYZER_ENABLED="false"

# Vercel Blob — resume file storage in production (auto-injected when a store is linked)
# BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# Database (PostgreSQL) — Neon, Supabase, or local Postgres
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jobtracker_ai?schema=public"

# Auth.js — generate secret: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
AUTH_URL="http://localhost:3000"

# Google Gemini — cover letter generator (free tier: https://aistudio.google.com/apikey)
# New AI Studio keys start with AQ. ; legacy keys start with AIzaSy
GEMINI_API_KEY="AQ...."
# Optional: override the model (defaults to gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# OpenAI — resume analyzer only (https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-..."
# Optional: override the model (defaults to gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"

# MCP stdio server — local trusted process identity (pick one)
# Tools run as this user only; never pass arbitrary user ids from clients.
# MCP_USER_ID="clxxxxxxxx"
MCP_USER_EMAIL="demo@jobtracker.ai"

# Note: resume file uploads are stored locally in storage/uploads/resumes/.
# On Vercel, use cloud storage (S3, Vercel Blob) for production resume uploads.
